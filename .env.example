# Application Settings
APP_ENV=development
APP_DEBUG=true
PORT=8000
HOST=0.0.0.0

# LLM Providers (Pick at least one)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Qdrant Vector DB Settings
# Local Docker or Standalone binary:
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
# Or Local embedded path (if running without Docker):
# QDRANT_PATH=./qdrant_data
QDRANT_COLLECTION_NAME=In-Course_Agentic_RAG_Copilot

# Redis Settings
REDIS_URL=redis://localhost:6379/0

# Embedding & Reranking Settings
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-large
SPARSE_MODEL_NAME=Qdrant/bm25
RERANKER_MODEL_NAME=jinaai/jina-reranker-v2-base-multilingual
USE_ONNX=true
MIN_SCORE_THRESHOLD=0.25
CODE_SCORE_THRESHOLD=0.35
VIDEO_SCORE_THRESHOLD=0.22
VIDEO_FALLBACK_MIN_THRESHOLD=0.15

# Whisper Ingestion Settings
WHISPER_MODEL_SIZE=large-v3
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
